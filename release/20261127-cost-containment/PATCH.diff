-# Stage 3 as a route.
+# Stage 3 as a route: SINGLE MEMBER. Owner directive 2026-11-27 removed the
+# DeepSeek V4 Pro escalation from this group for cost containment; Flash
+# exhaustion, congestion, incompatibility or provider failure must not select a
+# more expensive sibling, and there is no sibling left to select. A singleton
+# group route carries no `candidates`, so the group and the pool cannot drift.
+[routes.smart-deepseek-flash]
+id = "smart-deepseek-flash"
+type = "passthrough"
+target = "deepseek-deepseek-flash"
+candidates = []
+selection = "declared"
+context_window = 1048576
+tool_calling = true
+reasoning = true
+vision = true
+video = false
+
+# Compatibility alias, same singleton membership as the group above. Kept so an
+# existing consumer of `smart-deepseek` keeps answering instead of 404ing; it
+# cannot reach V4 Pro either, because the target carries no pool membership and
+# this route names no candidate.
 [routes.smart-deepseek]
 id = "smart-deepseek"
 type = "passthrough"
 target = "deepseek-deepseek-flash"
-candidates = ["deepseek-deepseek-v4-pro"]
+candidates = []
 selection = "declared"
 context_window = 1048576
 tool_calling = true
@@ -2194,9 +2215,11 @@
 # Flash sibling.
 [targets.deepseek-deepseek-v4-pro]
 
-# Pool membership label. A route that names this group ranks the whole group before it
-# ranks any leaf; the label is the manifest's only record of which pool a leaf serves.
-groups = ["smart-deepseek"]
+# Deliberately NOT a member of any pool group. Owner directive 2026-11-27: V4 Pro
+# must be unreachable through smart-route on every path, including group membership,
